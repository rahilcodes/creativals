<IfModule mod_rewrite.c>
RewriteEngine On

# ── Canonical host: www -> apex (301, preserves path + query) ───────────────
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

# ── 301 redirects: legacy URLs from the old sitemap/site ────────────────────
# Old singular prefixes -> current plural routes (slugs are identical)
RewriteRule ^service/(.+)$ /services/$1 [R=301,L]
RewriteRule ^industry/(.+)$ /industries/$1 [R=301,L]
RewriteRule ^about/?$ /about-us [R=301,L]
# Pages removed until verified content exists (CLAUDE.md content policy)
RewriteRule ^success-stories/?$ /results [R=301,L]
RewriteRule ^client-reviews/?$ /results [R=301,L]

# ── Trailing slash -> clean URL (canonical form, except root) ───────────────
RewriteCond %{REQUEST_URI} !^/dist/
RewriteRule ^(.+)/$ /$1 [R=301,L]

# ── Everything else serves from the built site in /dist ─────────────────────
RewriteCond %{REQUEST_URI} !^/dist/
RewriteRule ^(.*)$ /dist/$1 [L]
</IfModule>

# ── Security headers (audit 27 Jul 2026: HSTS Critical, nosniff/XFO High) ───
<IfModule mod_headers.c>
Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "geolocation=(), camera=(), microphone=()"
</IfModule>

# Explicit charset on the Content-Type HTTP header (doc-level meta already set)
AddDefaultCharset UTF-8
